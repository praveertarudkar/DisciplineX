rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isValidString(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    function isValidList(field, maxLen) {
      return request.resource.data[field] is list &&
             request.resource.data[field].size() <= maxLen;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "Iamkst34@gmail.com" && request.auth.token.email_verified == true));
    }

    // ===============================================================
    // User Profile Rules
    // ===============================================================
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'longestStreak', 'totalRelapses', 'badges']) &&
               data.uid == userId &&
               data.email is string &&
               data.displayName is string && data.displayName.size() <= 50 &&
               data.createdAt is number &&
               data.longestStreak is number &&
               data.totalRelapses is number &&
               data.badges is list;
      }

      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.uid == resource.data.uid;
    }

    // ===============================================================
    // Streak Rules
    // ===============================================================
    match /streaks/{streakId} {
      function isValidStreak(data) {
        return data.keys().hasAll(['id', 'userId', 'startDate', 'status', 'duration']) &&
               data.userId == request.auth.uid &&
               data.startDate is number &&
               data.status in ['active', 'relapsed'] &&
               data.duration is number;
      }

      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidStreak(request.resource.data);
      allow update: if isDocOwner() && isValidStreak(request.resource.data) &&
                      request.resource.data.startDate == resource.data.startDate &&
                      request.resource.data.userId == resource.data.userId;
      allow delete: if isDocOwner() || isAdmin();
    }

    // ===============================================================
    // Community Post Rules
    // ===============================================================
    match /posts/{postId} {
      function isValidPost(data) {
        return data.keys().hasAll(['id', 'userId', 'username', 'content', 'streakDays', 'likes', 'createdAt']) &&
               data.userId == request.auth.uid &&
               data.username is string && data.username.size() <= 50 &&
               data.content is string && data.content.size() <= 1000 &&
               data.streakDays is number &&
               data.likes is list &&
               data.createdAt is number;
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPost(request.resource.data);
      allow update: if isAuthenticated() && (
                      // Allow owner to edit content
                      (isDocOwner() && isValidPost(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt) ||
                      // Allow anyone to like/unlike (only modifying likes array)
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
                       request.resource.data.likes.size() <= resource.data.likes.size() + 1)
                    );
      allow delete: if isDocOwner() || isAdmin();
    }
  }
}
